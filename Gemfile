# frozen_string_literal: true

source 'https://rubygems.org'

# The TUI toolkit, straight from GitHub. Bundler clones the repository and
# puts lib/ on the load path, so `require 'ruby-tui'` works with no local
# checkout of the toolkit.
gem 'ruby-tui', github: 'adiprnm/ruby-tui'

group :test do
  gem 'minitest'
  gem 'rake'
end
